.screen-root {
    position: relative;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(22, 25, 31);
}

.boss-header {
    position: relative;
    align-items: center;
}

.boss-name {
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin-bottom: 10px;
}

.hp-bar-bg {
    width: 100%;
    max-width: 720px;
    height: 30px;
    background-color: rgb(40, 40, 40);
    border-width: 2px;
    border-color: rgb(0, 0, 0);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    align-items: center;
    justify-content: center;
}

.hp-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    background-color: rgb(200, 40, 40);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.hp-label {
    color: rgb(255, 255, 255);
    font-size: 16px;
    -unity-font-style: bold;
}

.shield-row {
    position: relative;
    flex-direction: row;
    justify-content: center;
}

.shield-icon {
    width: 84px;
    height: 84px;
    border-radius: 42px;
    align-items: center;
    justify-content: center;
    border-width: 2px;
    border-color: rgb(0, 0, 0);
    margin-left: 16px;
    margin-right: 16px;
}

.melee-icon {
    background-color: rgb(110, 60, 60);
}

.ranged-icon {
    background-color: rgb(120, 105, 50);
}

.magic-icon {
    background-color: rgb(55, 70, 115);
}

.shield-icon--active.melee-icon {
    background-color: rgb(200, 70, 70);
}

.shield-icon--active.ranged-icon {
    background-color: rgb(220, 180, 40);
}

.shield-icon--active.magic-icon {
    background-color: rgb(70, 100, 220);
}

.shield-label {
    color: rgb(255, 255, 255);
    font-size: 26px;
    -unity-font-style: bold;
}

.shield-caption {
    color: rgb(220, 220, 220);
    font-size: 11px;
}

.player-row {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 110px;
    flex-direction: row;
    justify-content: center;
}

.player-panel {
    position: relative;
    flex-direction: column;
    align-items: flex-start;
    background-color: rgb(32, 36, 44);
    padding: 16px;
    margin-left: 10px;
    margin-right: 10px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    border-width: 2px;
    border-color: rgb(60, 66, 78);
}

.player-panel-header {
    color: rgb(200, 208, 224);
    font-size: 13px;
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.player-panel--selectable {
    border-color: rgb(120, 200, 255);
}

.player-panel--active {
    border-color: rgb(255, 205, 80);
    border-width: 3px;
    scale: 1.1 1.1;
}

.attack-display {
    align-items: center;
    margin-bottom: 10px;
}

.attack-caption {
    color: rgb(170, 178, 192);
    font-size: 12px;
    -unity-font-style: bold;
}

.attack-value {
    color: rgb(255, 120, 100);
    font-size: 34px;
    -unity-font-style: bold;
}

.action-row {
    flex-direction: row;
}

.action-indicator {
    width: 20px;
    height: 20px;
    border-radius: 10px;
    background-color: rgb(70, 210, 125);
    border-width: 1px;
    border-color: rgb(10, 45, 20);
    margin-right: 10px;
}

.card-test-row {
    position: relative;
    right: 24px;
    bottom: 24px;
    flex-direction: row;
    align-items: flex-end;
    width: 320px;
}

.card-id-input {
    flex-grow: 1;
    margin-right: 8px;
}

.play-card-button {
    height: 24px;
}

.phase-popup {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.7);
    align-items: center;
    justify-content: center;
}

.phase-popup--notification {
    background-color: rgba(0, 0, 0, 0);
    align-items: center;
    justify-content: center;
    pointer-events: none;
}

.phase-popup--notification .phase-popup-content {
    width: auto;
    max-width: 480px;
    padding: 12px 20px;
}

.phase-popup-content {
    width: 420px;
    padding: 24px;
    background-color: rgb(35, 40, 48);
    border-width: 2px;
    border-color: rgb(210, 180, 70);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}

.phase-popup-title {
    color: rgb(255, 220, 105);
    font-size: 24px;
    -unity-font-style: bold;
    margin-bottom: 10px;
}

.phase-popup-message {
    color: rgb(255, 255, 255);
    white-space: normal;
    margin-bottom: 16px;
}

.close-phase-popup-button {
    align-self: flex-end;
}

.message-popup {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.7);
    align-items: center;
    justify-content: center;
}

.message-popup-content {
    width: 420px;
    padding: 24px;
    background-color: rgb(62, 37, 37);
    border-width: 2px;
    border-color: rgb(220, 95, 75);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}

.message-popup-title {
    color: rgb(255, 155, 130);
    font-size: 24px;
    -unity-font-style: bold;
    margin-bottom: 10px;
}

.message-popup-text {
    color: rgb(255, 255, 255);
    white-space: normal;
    margin-bottom: 16px;
}

.close-message-popup-button {
    align-self: flex-end;
}
