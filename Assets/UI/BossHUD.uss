.screen-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hud-root {
    position: absolute;
    top: 20px;
    left: 20px;
    width: 320px;
}

.boss-name {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin-bottom: 6px;
}

.hp-bar-bg {
    width: 100%;
    height: 24px;
    background-color: rgb(40, 40, 40);
    border-width: 2px;
    border-color: rgb(0, 0, 0);
    margin-bottom: 10px;
    align-items: center;
    justify-content: center;
}

.hp-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    background-color: rgb(200, 40, 40);
}

.hp-label {
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.shield-row {
    flex-direction: row;
    justify-content: space-between;
}

.shield-icon {
    width: 56px;
    height: 56px;
    border-radius: 28px;
    align-items: center;
    justify-content: center;
    border-width: 2px;
    border-color: rgb(0, 0, 0);
}

.melee-icon {
    background-color: rgb(180, 60, 60);
}

.ranged-icon {
    background-color: rgb(238, 194, 19);
}

.magic-icon {
    background-color: rgb(60, 90, 200);
}

.shield-label {
    color: rgb(255, 255, 255);
    font-size: 20px;
    -unity-font-style: bold;
}

.action-row {
    flex-direction: row;
    margin-top: 12px;
}

.action-indicator {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    background-color: rgb(70, 210, 125);
    border-width: 1px;
    border-color: rgb(10, 45, 20);
    margin-right: 8px;
}

.card-test-row {
    flex-direction: row;
    align-items: flex-end;
    margin-top: 12px;
}

.card-id-input {
    flex-grow: 1;
    margin-right: 8px;
}

.play-card-button {
    height: 22px;
}

.next-phase-button {
    margin-top: 12px;
}

.phase-popup {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.7);
    align-items: center;
    justify-content: center;
}

.phase-popup-content {
    width: 320px;
    padding: 20px;
    background-color: rgb(35, 40, 48);
    border-width: 2px;
    border-color: rgb(210, 180, 70);
}

.phase-popup-title {
    color: rgb(255, 220, 105);
    font-size: 22px;
    -unity-font-style: bold;
    margin-bottom: 10px;
}

.phase-popup-message {
    color: rgb(255, 255, 255);
    white-space: normal;
    margin-bottom: 16px;
}

.close-phase-popup-button {
    align-self: flex-end;
}

.message-popup {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.7);
    align-items: center;
    justify-content: center;
}

.message-popup-content {
    width: 320px;
    padding: 20px;
    background-color: rgb(62, 37, 37);
    border-width: 2px;
    border-color: rgb(220, 95, 75);
}

.message-popup-title {
    color: rgb(255, 155, 130);
    font-size: 22px;
    -unity-font-style: bold;
    margin-bottom: 10px;
}

.message-popup-text {
    color: rgb(255, 255, 255);
    white-space: normal;
    margin-bottom: 16px;
}

.close-message-popup-button {
    align-self: flex-end;
}
